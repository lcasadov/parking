# Override OPCIONAL del baseURL del cliente API.
# Por defecto vacio: el cliente usa el baseURL relativo /parking-api/api/v1
# (dev-proxy de Vite en desarrollo, same-origin en produccion). Sin CORS.
# Solo define esto si necesitas apuntar a un host distinto.
VITE_API_URL=

# Token PÚBLICO de Mapbox (pk.*) para el mapa de dirección del parking.
# Es de cliente (Mapbox GL corre en el navegador). Ponlo en .env.local (no se commitea).
VITE_MAPBOX_TOKEN=
