# Plantilla de variables de entorno — SÍ versionar (sin valores reales).
# Copiar a `.env` y rellenar. El `.env` real está excluido por .gitignore.

# --- SMTP ---
# LOCAL / DES / PRE: Ethereal (https://ethereal.email) — buzón de pruebas.
# PRO: SMTP corporativo de ALEATICA.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USERNAME=<usuario-ethereal>
SMTP_PASSWORD=<password-ethereal>
SMTP_AUTH=true
SMTP_STARTTLS=true

# --- Bootstrap del primer administrador (perfil docker/pro) ---
# En un despliegue limpio la tabla `employees` nace vacía y nadie puede loguearse
# (POST /employees exige rol ADMIN). Este mecanismo crea el primer admin al arrancar,
# de forma IDEMPOTENTE: solo lo crea si aún no existe ningún ADMIN.
#
# Actívalo poniendo ENABLED=true y rellenando EMAIL + PASSWORD. Déjalo en false
# (o vacía email/password) para no crear nada. El admin nace con
# password_must_change=true: deberá cambiar la contraseña en el primer login.
# La contraseña debe cumplir la política (≥10, mayúsc.+minúsc.+dígito+símbolo,
# distinta de login/email). NUNCA subas un `.env` con credenciales reales.
PARKING_BOOTSTRAP_ADMIN_ENABLED=false
PARKING_BOOTSTRAP_ADMIN_EMAIL=
PARKING_BOOTSTRAP_ADMIN_PASSWORD=
# Opcionales (tienen valores por defecto):
PARKING_BOOTSTRAP_ADMIN_FIRST_NAME=Admin
PARKING_BOOTSTRAP_ADMIN_LAST_NAME=Parking
# Login del admin; si se deja vacío se deriva de la parte local del email.
PARKING_BOOTSTRAP_ADMIN_LOGIN=
PARKING_BOOTSTRAP_ADMIN_PHONE=
