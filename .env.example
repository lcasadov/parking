# Plantilla de variables de entorno — SÍ versionar (sin valores reales).
# Copiar a `.env` y rellenar. El `.env` real está excluido por .gitignore.

# --- SMTP ---
# LOCAL / DES / PRE: Ethereal (https://ethereal.email) — buzón de pruebas.
# PRO: SMTP corporativo de ALEATICA.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USERNAME=<usuario-ethereal>
SMTP_PASSWORD=<password-ethereal>
SMTP_AUTH=true
SMTP_STARTTLS=true
